# Copy this file to .env in this same folder (backend/gateway/.env) — the
# gateway reads .env from wherever `npm run dev` is invoked FROM, which must
# be this folder, not the repo root or backend/.

PORT=4000

# Must match wherever the frontend App Shell actually runs — the gateway
# rejects cross-origin requests from anything else. Default App Shell port
# in this repo is 3000.
CORS_ORIGIN=http://localhost:3000

# Only services that actually exist today are listed here (see
# src/config/services.ts — the rest are commented out there because
# IntrospectAndCompose requires every subgraph it's given to respond at
# startup, and the other 7 domains aren't built yet).
USER_URL=http://localhost:4001/graphql
OPPORTUNITY_URL=http://localhost:4003/graphql
ADMIN_URL=http://localhost:4010/graphql

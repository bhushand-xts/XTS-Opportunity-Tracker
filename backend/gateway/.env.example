# Copy to .env and fill in. .env is git-ignored — never commit real values.

PORT=4000
# Comma-separated list of frontend origins allowed to call the gateway.
# app-shell runs on 3000, the standalone admin MFE on 3001.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Subgraph URLs
USER_URL=http://localhost:4001/graphql
OPPORTUNITY_URL=http://localhost:4003/graphql
ADMIN_URL=http://localhost:4010/graphql

# Which subgraphs the gateway composes on boot (comma separated).
# Every listed service must be running, or the gateway fails to start.
ENABLED_SUBGRAPHS=user,opportunity,admin

# AI question extraction: forwards /api/question-extractions to the opportunity service.
QUESTION_EXTRACTION_ENABLED=true
# Must match EXTRACTION_SERVICE_SECRET in backend/services/opportunity/.env (32+ characters).
EXTRACTION_SERVICE_SECRET=

# Local-dev image shared by the gateway and every service. npm workspaces
# hoist dependencies to backend/node_modules, so the build context is the
# whole backend/ folder (see docker-compose.yml's `context: .`), not one
# service's own directory — installing from anywhere else would miss the
# hoisted packages.
#
# Not a production image: no multi-stage build, no compiled output — this
# runs the same `npm run dev` (tsx watch) each service already uses locally,
# so editing source on the host (see the volume mounts in docker-compose.yml)
# hot-reloads inside the container exactly like it does outside one.
FROM node:22-alpine

WORKDIR /app

# Installed before the rest of the source is copied in, so editing a .ts
# file doesn't invalidate this layer — only a package.json/lockfile change
# does, matching how `npm run install:all` already works for this repo.
COPY package.json package-lock.json ./
COPY gateway/package.json gateway/package.json
COPY services/user/package.json services/user/package.json
COPY services/admin/package.json services/admin/package.json
COPY services/opportunity/package.json services/opportunity/package.json
RUN npm ci

COPY . .

# Which service this container runs — set per-service in docker-compose.yml
# (e.g. "gateway" or "services/user").
ARG SERVICE_PATH
WORKDIR /app/${SERVICE_PATH}

CMD ["npm", "run", "dev"]

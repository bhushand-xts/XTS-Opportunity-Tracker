# Copy to .env and fill in. .env is git-ignored — never commit real values.

PORT=4003

DB_HOST=localhost
DB_PORT=5432
DB_NAME=xts_opportunity
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=10
USER_SERVICE_URL=http://localhost:4001/graphql
# ADMIN_SERVICE_URL=http://localhost:4010/graphql

# --- AI question extraction ---
QUESTION_EXTRACTION_ENABLED=true
# Shared secret between the gateway and this service. At least 32 characters;
# must match EXTRACTION_SERVICE_SECRET in backend/gateway/.env. Ask the team for it.
EXTRACTION_SERVICE_SECRET=
# Absolute folder where uploaded RFP documents are stored (git-ignored).
DOCUMENT_STORAGE_ROOT=D:/xts-opportunity-tracker/backend/storage/opportunity-documents
# Groq AI. Ask the team for the API key; never commit it.
GROQ_API_KEY=
GROQ_ZDR_CONFIRMED=true
GROQ_AI_EXTRACTION=true
GROQ_MODEL=openai/gpt-oss-120b
GROQ_QUOTA_SCOPE=question-extraction-groq-120b
# Optional limits (defaults shown): Groq free tier is 8,000 tokens/minute and 200,000/day.
# GROQ_TOKENS_PER_MINUTE=8000
# GROQ_TOKENS_PER_DAY=200000

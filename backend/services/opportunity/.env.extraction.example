# Add these to the opportunity service's existing .env; retain existing DB settings.
QUESTION_EXTRACTION_ENABLED=false
DOCUMENT_STORAGE_ROOT=D:/xts-opportunity-tracker/backend/storage/opportunity-documents
EXTRACTION_SERVICE_SECRET=replace-with-a-private-random-value-at-least-32-characters
# true: Groq extracts questions using the user's extraction instructions and can
# suggest instructions from the uploaded document. false: local rule-based
# matching only (no Groq key needed, no document content sent anywhere).
GROQ_AI_EXTRACTION=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Set true only after enabling Zero Data Retention in Groq organization Data Controls.
GROQ_ZDR_CONFIRMED=false
GROQ_QUOTA_SCOPE=question-extraction-groq
GROQ_REQUESTS_PER_MINUTE=30
GROQ_REQUESTS_PER_DAY=1000
GROQ_TOKENS_PER_MINUTE=8000
GROQ_TOKENS_PER_DAY=200000
GROQ_REQUEST_TOKENS=6200
DOCUMENT_UNATTACHED_RETENTION_DAYS=7
DOCUMENT_MAX_BYTES=26214400
DOCUMENT_MAX_PAGES=200
DOCUMENT_MAX_TEXT_CHARS=2000000
# Docker overlay enables the network-isolated parser queue automatically.
EXTRACTION_PARSER_QUEUE=false
EXTRACTION_PARSER_TIMEOUT_MS=60000
LIBREOFFICE_COMMAND=soffice
OCRMYPDF_COMMAND=ocrmypdf

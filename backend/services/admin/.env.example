# Copy this file to .env in this same folder (backend/services/admin/.env) —
# each service reads .env from wherever `npm run dev` is invoked FROM, which
# must be this folder, not the repo root or backend/.
#
# DB_HOST below is the team's shared dev Postgres server. Connecting to it
# requires your machine's IP to be allowed in its pg_hba.conf — ask whoever
# administers that server if a new machine gets
# "no pg_hba.conf entry for host ..." on startup.

PORT=4010

DB_HOST=172.16.121.53
DB_PORT=5432
DB_NAME=admin_db
DB_USER=opportunityuser
DB_PASSWORD=opportunityTracker
DB_POOL_MAX=10

# Cross-service call target — leave as default unless the user service is
# running on a non-default port.
USER_SERVICE_URL=http://localhost:4001/graphql

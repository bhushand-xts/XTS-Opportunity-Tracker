# Copy to .env and fill in. .env is git-ignored — never commit real values.

PORT=4001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=xts_user
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=10

# the /admin dashboard proxies to the admin service
ADMIN_SERVICE_URL=http://localhost:4010/graphql

# Where a password-reset link points (the app-shell's own origin).
FRONTEND_URL=http://localhost:3000

# SMTP — used to send forgot-password emails. Zoho Mail example: host
# smtp.zoho.com (or smtp.zoho.eu / smtp.zoho.in depending on your account's
# data center), port 587, SMTP_USER/SMTP_PASS = the mailbox's email address
# and an app-specific password (Zoho Mail Settings > Security > App Passwords
# — requires two-factor auth to be enabled on that account).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Leave true unless you hit "unable to verify the first certificate" —
# that means this network's outbound TLS is intercepted by a corporate proxy
# using a certificate Node doesn't trust. Only then set this to false.
SMTP_REJECT_UNAUTHORIZED=true

# Opt-in worker with native DOC conversion and scanned-PDF OCR.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends libreoffice-writer ocrmypdf tesseract-ocr-eng fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY gateway/package.json gateway/package.json
COPY services/user/package.json services/user/package.json
COPY services/admin/package.json services/admin/package.json
COPY services/opportunity/package.json services/opportunity/package.json
RUN npm ci
COPY . .
RUN mkdir -p /app/storage/opportunity-documents && chown -R node:node /app/storage
USER node
WORKDIR /app/services/opportunity
CMD ["npm", "run", "worker:extraction"]

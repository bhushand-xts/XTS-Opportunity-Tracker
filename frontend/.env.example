# Copy this file to .env in this same folder (frontend/.env) if you need to
# point at a backend gateway that ISN'T running on localhost:4000 — e.g.
# someone else's machine, or a deployed environment.
#
# If you're running the full stack locally (gateway + services on this same
# machine, which is the common case), you don't need this file at all — the
# app already defaults to http://localhost:4000/graphql without it.

GRAPHQL_API_URL=http://localhost:4000/graphql

# Same idea, for the mfe-admin remote that app-shell loads via Module
# Federation. Only needs overriding when mfe-admin ISN'T on localhost:3001
# (e.g. a deployed environment where the browser must reach it at a public
# address instead).
ADMIN_REMOTE_URL=http://localhost:3001

# Opportunity remote loaded by app-shell; override for deployed environments.
OPPORTUNITY_REMOTE_URL=http://localhost:3002

# The opportunity backend service's own base URL (its direct REST endpoints,
# not the gateway) — used for document upload/download. Override for deployed
# environments the same way as the others above.
OPPORTUNITY_SERVICE_URL=http://localhost:4003

# The Scope & Assessment and Estimate tabs always layer browser-local records
# (via localStorage) on top of the real Opportunity record, since the backend
# doesn't persist those modules yet — see localWorkflowService.ts. Everything
# else (list, detail, save, lookups, etc.) still hits the real API; this flag
# no longer controls that layering. It now only disables document upload/AI
# question extraction, for cases where you want to test without it.
OPPORTUNITY_USE_LOCAL_WORKFLOW=false

# Shows document upload and AI question extraction on Questionnaire-based RFPs.
QUESTION_EXTRACTION_ENABLED=true

{
  "name": "xts-opportunity-tracker-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/@xts/app-shell",
    "packages/@xts/design-system",
    "packages/@xts/api-contracts",
    "packages/@xts/mfe-admin",
    "packages/@xts/mfe-opportunity",
    "packages/@xts/mfe-solution",
    "packages/@xts/mfe-approval",
    "packages/@xts/mfe-dashboard",
    "packages/@xts/api-client"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^2.9.0",
    "autoprefixer": "^10.6.0",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "postcss": "^8.5.28",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "ts-loader": "^9.6.2",
    "typescript": "^5.3.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "vitest": "^2.1.5",
    "@vitest/coverage-v8": "^2.1.5",
    "@testing-library/react": "^16.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "jsdom": "^25.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.5.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "react-router-dom": "7.18.3"
  }
}
